PORT=3000
HOST=127.0.0.1
BIND_ADDRESS=127.0.0.1
RUNTIME_DIR=./runtime
COOKIE_SECURE=false
LOG_LEVEL=info

# For HTTPS hosting, set COOKIE_SECURE=true and your exact external origin:
# PUBLIC_ORIGIN=https://names.example.com
# Only set TRUST_PROXY to the IP/CIDR of a proxy you control, if needed for rate limits.
# TRUST_PROXY=loopback
